# Copy this file to `.env.local` for local development. `.env.local` is git-ignored.
#
# Everything starting with VITE_ is compiled into the PUBLIC website bundle.
# Only put public values here. Never add your Tebex private key, webhook secret or any password.
# The build refuses to run if a VITE_ variable name contains PRIVATE, SECRET, PASSWORD or WEBHOOK.

# Your Tebex Headless API *public* token (creator.tebex.io → Developers → API Keys → "Public Token").
# It starts with a short prefix and a dash, e.g. "abcd-0123456789abcdef…". It is safe to expose.
VITE_TEBEX_PUBLIC_TOKEN=

# Optional. Base path the site is served from. The GitHub Actions workflow sets this automatically
# ("/<repository-name>/" for a project site, "/" for a custom domain or <user>.github.io).
# VITE_BASE_PATH=/

# Optional. Absolute site URL without a trailing slash, used for share previews (og:url, og:image)
# and sitemap.xml. The workflow sets this automatically on GitHub Pages.
# VITE_SITE_URL=https://example.github.io/mikescripts-storefront
